{
  "name": "jolt",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:mobile": "turbo run dev --filter=@jolt/mobile",
    "dev:desktop": "turbo run dev --filter=@jolt/desktop",
    "dev:editor-lab": "turbo run dev --filter=@jolt/editor-lab",
    "generate": "turbo run generate",
    "build": "turbo run build",
    "build:types": "turbo run build:types",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:conformance": "turbo run test:conformance",
    "test:relay": "turbo run test:relay",
    "check": "turbo run generate lint typecheck test test:conformance test:relay --filter=!@jolt/mobile --filter=!@jolt/desktop --filter=!@jolt/editor-lab",
    "verify:platforms": "bun scripts/verify-platforms.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
