{
  "name": "@jot/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo start --ios --dev-client",
    "android": "expo start --android --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@jot/core": "workspace:*",
    "@jot/editor-native": "workspace:*",
    "@jot/import-export": "workspace:*",
    "@jot/local-store": "workspace:*",
    "@jot/local-store-expo": "workspace:*",
    "@jot/schema": "workspace:*",
    "@jot/tokens": "workspace:*",
    "@jot/ui-mobile": "workspace:*",
    "expo": "57.0.21",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.18",
    "expo-file-system": "57.0.6",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.20",
    "expo-sharing": "57.0.18",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../packages"
      ]
    }
  }
}
