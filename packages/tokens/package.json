{
  "name": "@jolt/tokens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "@jolt/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "@jolt/source": "./generated/tokens.ts",
      "types": "./generated/tokens.ts",
      "default": "./generated/tokens.ts"
    },
    "./tokens.css": "./generated/tokens.css",
    "./tokens.json": "./src/tokens.json"
  },
  "scripts": {
    "generate": "bun src/generate.ts",
    "build:types": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config src/vitest.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
