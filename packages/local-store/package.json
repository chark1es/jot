{
  "name": "@jot/local-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@jot/source": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./bun": {
      "types": "./dist/bun-sqlite.d.ts",
      "@jot/source": "./src/bun-sqlite.ts",
      "import": "./src/bun-sqlite.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "bun --bun vitest run",
    "bench:vault": "bun benchmarks/vault-10k.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@jot/schema": "workspace:*"
  },
  "devDependencies": {
    "@jot/tsconfig": "workspace:*"
  }
}
