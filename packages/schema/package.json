{
  "name": "@jot/schema",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@jot/source": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "bun src/cli/generate.ts",
    "build:types": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:conformance": "vitest run src/conformance.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
