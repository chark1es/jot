{
  "name": "@jot/editor-native",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@jot/source": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -b",
