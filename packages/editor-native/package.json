    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@jot/schema": "workspace:*",
    "expo-modules-core": "57.0.18"
  },
  "peerDependencies": {
    "expo": "57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@jot/tsconfig": "workspace:*",
    "@types/react": "19.2.2"
  }
}
