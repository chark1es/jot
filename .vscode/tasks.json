{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jot: Install on selected device",
      "type": "shell",
      "command": "bun scripts/device.ts install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Jot: Select device",
      "type": "shell",
      "command": "bun scripts/device.ts select",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
